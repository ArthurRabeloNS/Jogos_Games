<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SteveCube</AssemblyName>
    <RootNamespace>SteveCube</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OC2>D:\SteamLibrary\steamapps\common\Overcooked! 2</OC2>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="UnityEngine">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- NOVOS (Blocks.cs): fisica e teclado. Se algum arquivo nao existir na sua versao do Unity,
         o build so avisa (warning) e segue; so da erro se o tipo nao for achado em nenhum deles. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(OC2)\Overcooked2_Data\Managed\UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>


    <Reference Include="BepInEx">
      <HintPath>$(OC2)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OC2)\BepInEx\plugins" />
  </Target>
</Project>
